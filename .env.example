# Copy this file to .env and fill in ONE of the two options. .env is git-ignored.

# --- Not sure what your Azure key serves? Fill just these two and run: py tools/probe_azure.py
# AZURE_ENDPOINT=<the endpoint URL you were given>
# AZURE_API_KEY=<your key>

# --- Option A: Claude on Microsoft Foundry (Azure) ---
# Resource name is the part before .services.ai.azure.com in your endpoint,
# e.g. https://my-resource.services.ai.azure.com/anthropic/  ->  my-resource
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
# ...or give the full endpoint instead of the resource name (not both):
# ANTHROPIC_FOUNDRY_BASE_URL=https://my-resource.services.ai.azure.com/anthropic/

# Your Foundry DEPLOYMENT name for Claude (often identical to the model id)
VERA_MODEL=claude-opus-5

# --- Option B: Claude API directly ---
# ANTHROPIC_API_KEY=

# --- Local scoring only (tools/score_pairs.py runs magicpin's judge prompt) ---
# Not needed on the deployed bot. With only the Foundry settings above filled in, Claude on
# Foundry is the judge automatically. To judge with an OpenAI model deployed on the same
# Foundry/Azure resource instead (the same key usually works):
# AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com
# JUDGE_MODEL=<your GPT deployment name>
# Or with a regular openai.com key:
# OPENAI_API_KEY=

# Shown by GET /v1/metadata
VERA_TEAM_NAME=Sarthak Gupta
VERA_TEAM_MEMBERS=Sarthak Gupta
VERA_CONTACT_EMAIL=

# Optional tuning
# VERA_EFFORT=low
# VERA_LLM_TIMEOUT_S=14
# VERA_MAX_MERCHANT_SENDS_PER_TICK=1
